---
import type { EssayLanguage } from '../lib/i18n';
import Icon from './Icon.astro';

interface TechnicalSource {
  kind:
    | 'paper'
    | 'code'
    | 'notebook'
    | 'dataset'
    | 'documentation'
    | 'article';
  title: string;
  url: string;
  note?: string;
  citation?: string;
}

interface Props {
  sources: readonly TechnicalSource[];
  lang?: EssayLanguage;
}

const { sources, lang = 'en' } = Astro.props;
const chinese = lang === 'zh-CN';
const kindLabels: Record<TechnicalSource['kind'], string> = chinese
  ? {
      paper: '论文',
      code: '代码',
      notebook: '笔记本',
      dataset: '数据集',
      documentation: '文档',
      article: '文章',
    }
  : {
      paper: 'Paper',
      code: 'Code',
      notebook: 'Notebook',
      dataset: 'Dataset',
      documentation: 'Documentation',
      article: 'Article',
    };
---

{
  sources.length > 0 && (
    <section
      class="technical-sources"
      data-technical-sources
      data-essay-extra
      aria-labelledby="technical-sources-title"
    >
      <div class="technical-sources__head">
        <p>{chinese ? '资料架' : 'Source shelf'}</p>
        <h2 id="technical-sources-title">
          {chinese ? '复现与延伸阅读' : 'Reproduce or read further'}
        </h2>
      </div>
      <ul>
        {sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              <span class="technical-sources__kind">{kindLabels[source.kind]}</span>
              <strong>{source.title}</strong>
              <Icon name="arrow-up-right" size={14} />
            </a>
            {source.citation && (
              <cite class="technical-sources__citation">{source.citation}</cite>
            )}
            {source.note && <p>{source.note}</p>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .technical-sources {
    margin-top: 3rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-sand) 22%, transparent);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--color-sand) 8%, transparent), transparent 42%),
      color-mix(in srgb, var(--color-panel) 45%, transparent);
  }
  .technical-sources__head > p {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .technical-sources .technical-sources__head h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: var(--text-step-1);
    font-weight: 400;
    color: var(--color-cream);
  }
  .technical-sources ul {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .technical-sources li {
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 14%, transparent);
  }
  .technical-sources li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .technical-sources a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: baseline;
    color: var(--color-cream);
    text-decoration: none;
  }
  .technical-sources a:hover strong {
    color: white;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .technical-sources__kind {
    padding: 0.15rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-sand) 28%, transparent);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-sand);
  }
  .technical-sources strong {
    font-family: var(--font-ui);
    font-size: var(--text-step--1);
    font-weight: 500;
    line-height: 1.45;
    transition: color 0.2s;
  }
  .technical-sources__citation,
  .technical-sources li > p {
    display: block;
    margin: 0.35rem 0 0;
    padding-left: calc(3.5rem + 0.65rem);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-style: normal;
    line-height: 1.55;
    color: var(--color-muted);
  }
  @media (max-width: 520px) {
    .technical-sources a {
      grid-template-columns: 1fr auto;
    }
    .technical-sources__kind {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .technical-sources__citation,
    .technical-sources li > p {
      padding-left: 0;
    }
  }
</style>
