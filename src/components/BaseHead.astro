---
import { SITE_TITLE, SITE_DESCRIPTION, OG_IMAGE, TWITTER_HANDLE } from '../consts';
import {
  LANGUAGE_INFO,
  localeFeed,
  languageOf,
  type EssayLanguage,
  type LanguageAlternate,
} from '../lib/i18n';

interface ArticleMetadata {
  publishedTime: Date;
  modifiedTime?: Date;
  tags: readonly string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  lang?: EssayLanguage;
  languageAlternates?: readonly LanguageAlternate[];
  article?: ArticleMetadata;
  alternateFeeds?: readonly {
    href: string;
    title: string;
  }[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = OG_IMAGE,
  type = 'website',
  lang = 'en',
  languageAlternates = [],
  article,
  alternateFeeds = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const rssUrl = new URL(localeFeed(lang), Astro.site);
const currentLocale = LANGUAGE_INFO[languageOf({ lang })].openGraphLocale;
const alternateLocaleLinks = languageAlternates.map((alternate) => ({
  ...alternate,
  url: new URL(alternate.href, Astro.site),
  locale: LANGUAGE_INFO[alternate.language].openGraphLocale,
}));
const defaultLanguageUrl =
  lang === 'en'
    ? canonical
    : alternateLocaleLinks.find((alternate) => alternate.language === 'en')
        ?.url;
const structuredData =
  type === 'article' && article
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageUrl.href,
        datePublished: article.publishedTime.toISOString(),
        dateModified: (
          article.modifiedTime ?? article.publishedTime
        ).toISOString(),
        inLanguage: lang,
        keywords: article.tags,
        mainEntityOfPage: canonical.href,
        url: canonical.href,
        author: {
          '@type': 'Person',
          name: 'ssword',
          url: 'https://github.com/ssword',
        },
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          url: new URL('/', Astro.site).href,
        },
      }).replaceAll('<', '\\u003c')
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  languageAlternates.length > 0 && (
    <>
      <link rel="alternate" hreflang={lang} href={canonical} />
      {alternateLocaleLinks.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.language}
          href={alternate.url}
        />
      ))}
      {defaultLanguageUrl && (
        <link rel="alternate" hreflang="x-default" href={defaultLanguageUrl} />
      )}
    </>
  )
}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />
{
  alternateFeeds.map((feed) => (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feed.title}
      href={new URL(feed.href, Astro.site)}
    />
  ))
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={currentLocale} />
{
  alternateLocaleLinks.map((alternate) => (
    <meta property="og:locale:alternate" content={alternate.locale} />
  ))
}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? SITE_TITLE} />
{
  type === 'article' && article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      {article.modifiedTime && (
        <meta
          property="article:modified_time"
          content={article.modifiedTime.toISOString()}
        />
      )}
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title ?? SITE_TITLE} />

{
  structuredData && (
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredData}
    />
  )
}
