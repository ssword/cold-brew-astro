---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publishedEssays, toDisplayEssays } from '../../lib/essays';
import { essaysInLanguage } from '../../lib/i18n';
import EssayCard from '../../components/EssayCard.astro';
import AmbientCafe from '../../components/AmbientCafe.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }];
}

const { published: allPublished } = publishedEssays(
  await getCollection('essays'),
);
const published = essaysInLanguage(allPublished, 'zh-CN');
const [featured, ...rest] = await toDisplayEssays(published, render);
---

<BaseLayout
  lang="zh-CN"
  title="文章"
  description="慢慢思考深度学习、语言模型与统计学；有些想法，不该被催熟。"
  languageAlternates={[
    { language: 'en', href: '/', label: 'English' },
  ]}
>
  <div class="home mx-auto w-full max-w-2xl pb-16">
    <section data-hero class="pb-12 text-center sm:pb-16">
      <p class="font-body text-lg italic leading-relaxed text-muted">
        慢慢思考深度学习、语言模型与统计学；有些想法，不该被催熟。
      </p>
      <p class="mt-4 font-mono text-xs uppercase tracking-widest text-sand">
        让它慢慢浸泡
      </p>
    </section>

    <div class="space-y-12 sm:space-y-14">
      {featured && (
        <EssayCard
          essay={featured.essay}
          href={featured.href}
          minutesRead={featured.minutesRead}
          variant="featured"
        />
      )}
      <ul class="space-y-12 sm:space-y-14" data-essay-list>
        {
          rest.map(({ essay, href, minutesRead }) => (
            <EssayCard
              essay={essay}
              href={href}
              minutesRead={minutesRead}
              variant="list-item"
            />
          ))
        }
      </ul>
    </div>

    <div class="pt-16 sm:pt-20">
      <AmbientCafe />
    </div>
  </div>
</BaseLayout>
