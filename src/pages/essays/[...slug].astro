---
import { getCollection } from 'astro:content';
import EssayPage from '../../components/EssayPage.astro';
import { publishedEssays } from '../../lib/essays';
import {
  essaySlug,
  essaysInLanguage,
} from '../../lib/i18n';

export async function getStaticPaths() {
  const { published: allPublished } = publishedEssays(
    await getCollection('essays'),
  );
  return essaysInLanguage(allPublished, 'en').map((essay) => ({
    params: { slug: essaySlug(essay) },
    props: { essay },
  }));
}

const { essay } = Astro.props;
---

<EssayPage essay={essay} />
